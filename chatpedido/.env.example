# Variables de infraestructura para docker-compose.yml / docker-compose.prod.yml.
# El .env real de la aplicacion Laravel vive en services/laravel/.env (ver services/laravel/.env.example).
#
# IMPORTANTE: estas credenciales de MySQL deben coincidir exactamente con
# DB_DATABASE / DB_USERNAME / DB_PASSWORD en services/laravel/.env

COMPOSE_PROJECT_NAME=delivery

APP_PORT=8000

MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=delivery
MYSQL_USER=delivery
MYSQL_PASSWORD=delivery
